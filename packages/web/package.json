{
  "name": "@rootnative/web",
  "version": "0.0.0-alpha.2",
  "description": "A standalone web runtime for React Native apps",
  "license": "MIT",
  "homepage": "https://rootnative.github.io/web/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rootnative/web.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/rootnative/web/issues"
  },
  "keywords": [
    "react-native",
    "react",
    "web",
    "dom",
    "server-rendering",
    "ssr",
    "seo",
    "semantic-html"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./assets-registry": "./dist/assets-registry/index.js",
    "./dom": "./dist/dom/index.js",
    "./server": "./dist/server/index.js",
    "./style": "./dist/style/index.js",
    "./vite": "./dist/vite/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-native/normalize-colors": "0.88.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@babel/core": "^7.0.0",
    "react-native-worklets": ">=0.5.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-worklets": "0.13.0",
    "tsdown": "0.23.4",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
