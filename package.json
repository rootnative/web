{
  "name": "rootnative-web-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter './packages/*' build",
    "test": "pnpm -r test",
    "typecheck": "tsc -b",
    "docs:dev": "pnpm --filter @rootnative/web-docs dev",
    "docs:build": "pnpm --filter @rootnative/web-docs build",
    "docs:serve": "pnpm --filter @rootnative/web-docs serve",
    "build:llms": "node scripts/build-llms.mjs",
    "check:llms": "node scripts/build-llms.mjs --check"
  },
  "devDependencies": {
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
